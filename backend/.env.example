# Conexão com o PostgreSQL
# Padrão: banco do docker-compose.yml (docker compose up -d na raiz do projeto)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="postgresql://oficina:oficina@localhost:5434/oficina"

# Banco usado somente pelos testes automatizados (é apagado a cada execução)
DATABASE_URL_TEST="postgresql://oficina:oficina@localhost:5434/oficina_test"

# Servidor
PORT=3333

# Autenticação (troque por um texto longo e aleatório)
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="7d"

# Upload de imagens
UPLOAD_DIR="uploads"
UPLOAD_MAX_MB=5

# Funcionamento da oficina (horário local, fuso -03:00)
OFICINA_ABERTURA="08:00"
OFICINA_FECHAMENTO="18:00"
OFICINA_FUSO="-03:00"

# Administrador criado pelo seed
SEED_ADMIN_EMAIL="admin@oficina.com"
SEED_ADMIN_SENHA="admin123"
